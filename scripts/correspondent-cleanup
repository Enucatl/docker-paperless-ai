#!/usr/bin/env bash
set -euo pipefail

compose=(docker compose --profile cleanup)
command_name="${1:-start}"

generate() {
  "${compose[@]}" run --no-deps --rm ai-cleanup \
    --cleanup-typesafe \
    --cleanup-correspondents-plan /review/merge-plan.json \
    --cleanup-analysis-dir /review
}

weekly() {
  "${compose[@]}" run --no-deps --rm ai-cleanup \
    --cleanup-correspondents-weekly /review/merge-plan.json
}

case "$command_name" in
  generate)
    generate
    ;;
  weekly)
    weekly
    ;;
  review)
    "${compose[@]}" up --no-deps -d cleanup-review
    ;;
  start)
    "${compose[@]}" up --no-deps -d cleanup-review
    ;;
  stop)
    "${compose[@]}" stop cleanup-review
    ;;
  status)
    "${compose[@]}" ps cleanup-review
    ;;
  *)
    echo "usage: $0 {start|generate|weekly|review|stop|status}" >&2
    exit 2
    ;;
esac
