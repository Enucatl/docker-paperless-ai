# paperless-ai — environment variable reference
# Copy to .env and fill in your values.

# =============================================================================
# Database / Paperless-ngx
# =============================================================================

# Secret key — generate with: openssl rand -hex 32
PAPERLESS_SECRET_KEY=

# Database password
POSTGRES_PASSWORD=paperless
PAPERLESS_DBPASS=paperless

# Your domain (used by Traefik routing and PAPERLESS_URL)
DOCKER_DOMAIN=example.com

# Timezone — https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
PAPERLESS_TIME_ZONE=Europe/Zurich

# OCR language(s) — see tesseract-ocr language codes
PAPERLESS_OCR_LANGUAGE=deu

# Optional: extra Tesseract args, for example:
# PAPERLESS_OCR_USER_ARGS={"invalidate_digital_signatures": true, "continue_on_soft_render_error": true}
# PAPERLESS_OCR_USER_ARGS=

# UID/GID of the host user that owns the consume directory
USERMAP_UID=1000
USERMAP_GID=1000

# Paperless API token — get from: Settings → API Tokens in the UI
PAPERLESS_TOKEN=

# =============================================================================
# OCR
# =============================================================================

# Any OpenAI-compatible inference vision model string. Examples:
#   gemini/gemini-2.5-flash          (cloud, default — requires GOOGLE_API_KEY)
#   claude-3-5-sonnet-20241022       (cloud — requires ANTHROPIC_API_KEY)
#   gpt-4o                           (cloud — requires OPENAI_API_KEY)
#   openai/nanonets/Nanonets-OCR2-3B (local vLLM — set INFERENCE_OCR_ENDPOINT)
#   ollama/llava-llama3              (local Ollama — set INFERENCE_OCR_ENDPOINT)
INFERENCE_OCR_MODEL=google/gemini-3.1-flash-lite

# Base URL for a self-hosted OCR model server (Ollama or vLLM).
# Examples:
#   INFERENCE_OCR_ENDPOINT=http://workstation:11434
#   INFERENCE_OCR_ENDPOINT=http://workstation:8100/v1
# INFERENCE_OCR_ENDPOINT=

# OCR generation settings
# INFERENCE_OCR_TEMPERATURE=0.0
# INFERENCE_OCR_REASONING_EFFORT=minimal
# INFERENCE_OCR_EXTRA_KWARGS={"top_p": 0.95}

# =============================================================================
# Metadata Extraction
# =============================================================================

# Text-only model for title/date/correspondent extraction (called once per doc).
#   gemini/gemini-2.5-flash
#   openai/meta-llama/Llama-3.2-3B-Instruct   (local vLLM — set INFERENCE_METADATA_ENDPOINT)
#   ollama/llama3.2                            (local Ollama — set INFERENCE_METADATA_ENDPOINT)
INFERENCE_METADATA_MODEL=google/gemini-3.1-flash-lite

# Base URL for a self-hosted metadata model server.
# Examples:
#   INFERENCE_METADATA_ENDPOINT=http://workstation:11434
#   INFERENCE_METADATA_ENDPOINT=http://workstation:8101/v1
# INFERENCE_METADATA_ENDPOINT=

# Metadata generation settings
# INFERENCE_METADATA_TEMPERATURE=0.2
# INFERENCE_METADATA_REASONING_EFFORT=minimal
# INFERENCE_METADATA_MAX_TOKENS=1000
# INFERENCE_METADATA_EXTRA_KWARGS={"top_p": 0.95}

# =============================================================================
# Chat
# =============================================================================

# Chat model for the browser copilot. Set this explicitly; it does not fall
# back to INFERENCE_METADATA_MODEL.
INFERENCE_CHAT_MODEL=google/gemini-3.1-flash-lite

# Base URL for a self-hosted chat model server.
# Examples:
#   INFERENCE_CHAT_ENDPOINT=http://workstation:11434
#   INFERENCE_CHAT_ENDPOINT=http://workstation:8102/v1
# INFERENCE_CHAT_ENDPOINT=

# Chat generation settings
# INFERENCE_CHAT_TEMPERATURE=0.2
# INFERENCE_CHAT_REASONING_EFFORT=minimal
# INFERENCE_CHAT_MAX_TOKENS=1000
# INFERENCE_CHAT_EXTRA_KWARGS={"top_p": 0.95}

# Authenticated-user header supplied by your reverse proxy. Leave unset for
# the default Remote-User header, or when using the nullable single-user owner.
# CHAT_OWNER_HEADER=Remote-User

# =============================================================================
# API Keys
# =============================================================================

GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# HuggingFace token — required for gated models (e.g. Llama) on the workstation
# HF_TOKEN=

# =============================================================================
# Runtime
# =============================================================================

# Seconds between polls in watch mode
# POLL_INTERVAL=300

# Max documents processed concurrently per batch (increase for cloud models like Gemini,
# keep at 1-2 for local vLLM which handles its own continuous batching)
# OCR_CONCURRENCY=4

# Minimum deterministic local correspondent-match score required to reuse an
# existing Paperless correspondent.
# CORRESPONDENT_MATCH_THRESHOLD=0.80
# Lower score floor for sending correspondent cleanup cluster pairs to TypeSafe.
# CORRESPONDENT_CLEANUP_CANDIDATE_THRESHOLD=0.65
# Maximum disjoint cluster-merge rounds in a cleanup analysis.
# CORRESPONDENT_CLEANUP_MAX_ROUNDS=6
# Cleanup review state is stored in the existing Paperless Postgres database.
# CORRESPONDENT_CLEANUP_DB_HOST=db

# Tag name (must match what you configure in Paperless Workflows)
# TAG_PENDING=ai-review-pending

# Set to true to log actions without modifying any documents
# DRY_RUN=false

# =============================================================================
# Webhook Listener / Security
# =============================================================================

# Secret token for validating webhook requests from Paperless.
# If unset, the webhook endpoint is unauthenticated (suitable for private networks).
# Generate with: openssl rand -hex 32
# WEBHOOK_SECRET=
